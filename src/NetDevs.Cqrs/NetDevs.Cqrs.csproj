<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>NetDevs.Cqrs</AssemblyName>
		<RootNamespace>NetDevs.Cqrs</RootNamespace>
		<PackageId>NetDevs.Cqrs</PackageId>
		<Version>1.0.0</Version>
		<Authors>Sebastian Wnorowski</Authors>
		<Company>NIK</Company>
		<Description>
			Automatic CQRS handler registration for Microsoft.Extensions.DependencyInjection using Scrutor.

			Install and call:
			services.AddCqrsFromAssemblyContaining&lt;YourMarker&gt;();

			Scans IQueryHandler&lt;&gt;, ICommandHandler&lt;&gt; and ICommandHandler&lt;,&gt; from specified assemblies.

			Dependencies: NetDevs.Cqrs.Abstractions, Scrutor
		</Description>
		<PackageTags>cqrs;mediatr;dependency-injection;scrutor;di;clean-architecture;aspnetcore;handler-registration;assembly-scanning</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Scrutor" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NetDevs.Cqrs.Abstractions\NetDevs.Cqrs.Abstractions.csproj" />
	</ItemGroup>
</Project>
