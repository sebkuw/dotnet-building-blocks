<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sebkuw.ImportProcessor</AssemblyName>
    <RootNamespace>sebkuw.ImportProcessor</RootNamespace>
    <PackageId>sebkuw.ImportProcessor</PackageId>
    <Version>2.0.0</Version>
    <Authors>Sebastian Wnorowski</Authors>
    <Description>Streaming, domain-neutral CSV import pipeline with mapping, validation, preview, error reporting, batches, and idempotency extension points.</Description>
    <PackageTags>CSV Import Streaming Mapping Validation Idempotency</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
