<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>sebkuw.QueryableProcessor</AssemblyName>
		<RootNamespace>sebkuw.QueryableProcessor</RootNamespace>
		<PackageId>sebkuw.QueryableProcessor</PackageId>
		<Version>2.1.0</Version>
		<Authors>Sebastian Wnorowski</Authors>
		<Description>Dynamic IQueryable filtering, sorting, pagination, and EF Core projection with explicit JSON request and response contracts.</Description>
		<PackageTags>LINQ IQueryable Sorting Filtering Pagination Dynamic</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
		<None Update="CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
