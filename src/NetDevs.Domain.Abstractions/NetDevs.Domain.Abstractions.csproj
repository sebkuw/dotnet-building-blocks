<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>NetDevs.Domain.Abstractions</AssemblyName>
		<RootNamespace>NetDevs.Domain.Abstractions</RootNamespace>
		<PackageId>NetDevs.Domain.Abstractions</PackageId>
		<Version>1.0.1</Version>
		<Authors>Sebastian Wnorowski</Authors>
		<Description>Domain abstractions for entities and auditing contracts.</Description>
		<PackageTags>domain;abstractions;entities;auditing;clean-architecture</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
		<None Update="CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
