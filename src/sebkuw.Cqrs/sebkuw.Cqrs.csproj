<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>sebkuw.Cqrs</AssemblyName>
		<RootNamespace>sebkuw.Cqrs</RootNamespace>
		<PackageId>sebkuw.Cqrs</PackageId>
		<Version>2.0.0</Version>
		<Authors>Sebastian Wnorowski</Authors>
		<Description>
			Automatic CQRS handler registration for Microsoft.Extensions.DependencyInjection using Scrutor.

			Install and call:
			services.AddCqrsFromAssemblyContaining&lt;YourMarker&gt;();

			Scans IQueryHandler&lt;,&gt;, ICommandHandler&lt;&gt; and ICommandHandler&lt;,&gt; from specified assemblies.

			Dependencies: sebkuw.Cqrs.Abstractions, Scrutor
		</Description>
		<PackageTags>cqrs;mediatr;dependency-injection;scrutor;di;clean-architecture;aspnetcore;handler-registration;assembly-scanning</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Scrutor" />
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
		<None Update="CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\sebkuw.Cqrs.Abstractions\sebkuw.Cqrs.Abstractions.csproj" />
	</ItemGroup>
</Project>
